{
  "name": "chronoframe",
  "version": "1.0.0-rc.3",
  "author": {
    "name": "Timothy Yin",
    "email": "master@uniiem.com"
  },
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "db": "drizzle-kit",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio --port 3010",
    "db:check": "drizzle-kit check",
    "db:up": "drizzle-kit up",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "build": "NODE_OPTIONS=\"--max-old-space-size=8192\" nuxt build",
    "build:deps": "pnpm --filter @chronoframe/webgl-image build",
    "dev": "run-p dev:dep dev:wait-only",
    "dev:dep": "pnpm --filter @chronoframe/webgl-image dev",
    "dev:only": "nuxt dev --host",
    "dev:wait-only": "wait-on packages/webgl-image/dist && nuxt dev --host",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test": "vitest run",
    "test:watch": "vitest",
    "brand-logos": "node scripts/generate-brand-logos.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1129.0",
    "@aws-sdk/s3-request-presigner": "^3.1129.0",
    "@chronoframe/webgl-image": "workspace:*",
    "@indoorequal/vue-maplibre-gl": "^9.0.1",
    "@nuxt/fonts": "0.14.0",
    "@nuxt/icon": "2.5.1",
    "@nuxt/ui": "^4.11.1",
    "@nuxtjs/i18n": "10.6.0",
    "@pinia/nuxt": "^1.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@takumi-rs/core": "^2.13.7",
    "@unhead/vue": "^2.1.17",
    "@vingle/bmp-js": "^0.2.5",
    "@vueuse/nuxt": "14.4.0",
    "better-sqlite3": "^13.0.3",
    "dayjs-nuxt": "2.1.11",
    "drizzle-orm": "^0.45.2",
    "es-toolkit": "^1.52.0",
    "exiftool-vendored": "^38.0.1",
    "file-type": "^22.0.2",
    "heic-convert": "^2.1.0",
    "maplibre-gl": "^6.9.0",
    "motion-v": "^2.4.2",
    "nuxt": "^4.5.2",
    "nuxt-auth-utils": "0.5.30",
    "nuxt-gtag": "5.0.0",
    "nuxt-mapbox": "1.6.4",
    "nuxt-maplibre": "^1.2.2",
    "nuxt-og-image": "6.7.8",
    "pinia": "^4.0.3",
    "reka-ui": "^2.10.4",
    "sharp": "^0.34.5",
    "swiper": "^14.2.0",
    "systeminformation": "^5.33.10",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "thumbhash": "^0.1.1",
    "tippy.js": "^6.3.7",
    "unstorage": "^1.17.5",
    "vue": "^3.5.42",
    "vue-router": "^4.6.4",
    "wait-on": "^9.1.0",
    "zod": "^4.6.1"
  },
  "packageManager": "pnpm@12.4.0",
  "devDependencies": {
    "@iconify-json/carbon": "^1.2.27",
    "@iconify-json/fluent-emoji-flat": "^1.2.6",
    "@iconify-json/lucide": "^1.2.131",
    "@iconify-json/material-symbols": "^1.2.92",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/simple-icons": "^1.2.95",
    "@iconify-json/streamline": "^1.2.5",
    "@iconify-json/svg-spinners": "^1.2.4",
    "@iconify-json/tabler": "^1.2.38",
    "@nuxt/test-utils": "4.3.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/heic-convert": "^2.1.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vueuse/core": "^14.4.0",
    "baseline-browser-mapping": "^2.11.21",
    "consola": "^3.4.2",
    "dayjs": "^1.11.23",
    "drizzle-kit": "^0.31.10",
    "happy-dom": "^20.14.3",
    "mapbox-gl": "^3.30.0",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.82.0",
    "sass-embedded": "^1.104.0",
    "svg-path-bounds": "^1.0.2",
    "typescript": "^5.9.3",
    "vitepress": "2.0.0-alpha.17",
    "vitest": "^5.0.0"
  }
}
